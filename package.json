{
  "name": "kingcajun-bot",
  "version": "0.1.0",
  "private": true,
  "description": "King Cajun WhatsApp ordering bot with scheduled delivery, payment checks and kitchen integration",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "start:source": "tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "test": "vitest run --maxWorkers=1 --no-file-parallelism --testTimeout=25000"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@trigramco/ontolang": "file:admin-dashboard/vendor/ontolang-52b59c0.tgz",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "luxon": "^3.6.1",
    "pg": "^8.23.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/luxon": "^3.6.2",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/camiinthisthang/kingcajun-bot.git"
  }
}
