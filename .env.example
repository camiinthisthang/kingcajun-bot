# standby: silent; prelaunch: coming-soon replies; ordering: accepts orders.
# Keep standby while the phone app handles replies. Opening requires a redeploy.
BOT_MODE=standby
# Require full payment for all newly created orders; old orders keep their terms.
NEW_ORDERS_FULL_PAYMENT=false
# New intake can stay closed while existing orders and messages remain available.
NEW_ORDERS_PAUSED=false
NEW_ORDERS_PAUSE_REASON=temporary
# Private phone preview: allowlist + comma-separated numbers including country code.
BOT_AUDIENCE=all
WHATSAPP_ALLOWED_NUMBERS=
# Disposable hosted rehearsal; requires allowlist and cash_on_delivery.
PHONE_PREVIEW=false
PRELAUNCH_REPLY="¡Hola! 🦞 Gracias por escribir a King Cajun. Estamos preparando nuestro menú y pronto abriremos pedidos a domicilio. Por ahora aún no estamos tomando pedidos. ¡Gracias por acompañarnos!"
PRELAUNCH_REPLY_COOLDOWN_HOURS=6
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
# Local demo. Replace with Neon's pooled connection string for staging/production.
DATABASE_URL=pglite://./data/preorders-pg
BUSINESS_NAME=King Cajun
BUSINESS_TIMEZONE=America/Bogota
PREORDER_CUTOFF_HOURS=12
DELIVERY_AREA_HINT=Medellín, Colombia
MENU_IMAGE_PATH=./assets/menu-example.jpg
# Optional in production. Defaults to PUBLIC_BASE_URL/assets/menu.jpg
MENU_IMAGE_URL=
# Optional second image: a la carte and extras, sent after the combo menu.
MENU_EXTRAS_IMAGE_URL=
# Single spice level for new orders; blank preserves legacy choices.
STANDARD_SPICE=
BANK_NAME=Bancolombia
BANK_ACCOUNT_TYPE=Ahorros
BANK_ACCOUNT_NUMBER=000-000000-00
BANK_ACCOUNT_HOLDER=TU EMPRESA S.A.S.

# demo | meta
WHATSAPP_PROVIDER=demo
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=change-me
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
WHATSAPP_REMINDER_24H_TEMPLATE=preorder_reminder_24h
WHATSAPP_REMINDER_6H_TEMPLATE=preorder_reminder_24h
# Optional MARKETING template with four body parameters; utility reminder fallback.
WHATSAPP_REMINDER_UPSELL_TEMPLATE=
# Enable only after the cancellation template has been approved by Meta.
REMINDER_CONFIRMATIONS_ENABLED=false
WHATSAPP_CANCELLATION_TEMPLATE=order_cancelled_unconfirmed
WHATSAPP_PAYMENT_ALERT_TEMPLATE=payment_received_staff
# One or more private staff WhatsApp numbers, separated by commas.
PAYMENT_ALERT_WHATSAPP_NUMBERS=

# demo | bancolombia
PAYMENT_PROVIDER=demo
# Temporary bridge until Bancolombia merchant onboarding is complete.
ALLOW_DEMO_PAYMENTS_IN_PRODUCTION=false
# The production adapter is intentionally configured from the bank's onboarding pack.
BANCOLOMBIA_PURCHASE_INTENT_URL=
BANCOLOMBIA_CLIENT_ID=
BANCOLOMBIA_CLIENT_SECRET=
BANCOLOMBIA_CALLBACK_API_KEY=

# Protects read APIs intended for a future dashboard. Empty is allowed only in demo.
ADMIN_API_KEY=
INTERNAL_API_KEY=local-dev-key
REMINDER_POLL_MS=60000

# Direct-transfer launch: no gateway credentials required
# PAYMENT_PROVIDER=manual_transfer
# MANUAL_TRANSFER_INSTRUCTIONS=El equipo te compartirá los datos de la cuenta por este chat.

# Natural conversational ordering (keep private allowlist while evaluating).
AI_ORDERING_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# In private rehearsal, read published back-office configuration without writing real orders.
PHONE_PREVIEW_SYNC=false

# Collect food, date and address; record uncertainties for staff review.
FAST_CHECKOUT_ENABLED=false

# Onto POS pilot: enable on BOTH services only after local acceptance.
# Defaults off; uses the same PostgreSQL database and existing WhatsApp account.
POS_RUNTIME_ENABLED=false
# Approved es_CO utility template, body parameters: order reference, status text.
WHATSAPP_PROGRESS_TEMPLATE=
# Random shared secret for the local printer bridge (32+ characters).
POS_PRINT_TOKEN=

# Optional bank-mail integration: mailbox is configured per installation.
BANK_MAIL_ENABLED=false
BANK_MAIL_EMAIL=
GOOGLE_BANK_CLIENT_ID=
GOOGLE_BANK_CLIENT_SECRET=
BANK_MAIL_TOKEN_KEY=
# Supply your own payment QR image URL; no live bank QR is published.
PAYMENT_QR_IMAGE_URL=
