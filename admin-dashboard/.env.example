NODE_ENV=development
ADMIN_DASHBOARD_PORT=3002
ADMIN_DASHBOARD_USER=admin
ADMIN_DASHBOARD_PASSWORD=replace-with-a-long-random-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
# Production: set NODE_ENV=production and the dashboard's permanent HTTPS URL.
ADMIN_PUBLIC_URL=http://localhost:3002
# Same Neon project/branch/database used by the bot. Keep Neon's TLS URL options.
DATABASE_URL=postgresql://USER:PASSWORD@NEON_HOST/neondb?sslmode=require
